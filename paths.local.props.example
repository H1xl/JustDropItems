<!-- Copy to paths.local.props (git-ignored) and set your paths. $(APPDATA) is the environment variable. -->
<Project>
  <PropertyGroup>
    <!-- The game folder, the one that contains "Risk of Rain 2_Data". -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Risk of Rain 2</GameDir>
    <!-- The mod manager's profiles folder. r2modman: $(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles;
         Thunderstore Mod Manager: $(APPDATA)\Thunderstore Mod Manager\DataFolder\RiskOfRain2\profiles -->
    <ProfilesDir>$(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles</ProfilesDir>
    <!-- A profile with BepInEx and the mods the plugin references installed. -->
    <RefProfile>Default</RefProfile>
  </PropertyGroup>
</Project>